---
import "@fontsource-variable/bricolage-grotesque/wght.css";
import "@fontsource/hanken-grotesk/latin-300.css";
import "@fontsource/hanken-grotesk/latin-400.css";
import "@fontsource/hanken-grotesk/latin-500.css";
import "@fontsource/hanken-grotesk/latin-600.css";
import "../index.css";
import MobileMenu from "../components/layout/MobileMenu.astro";
import SiteFooter from "../components/layout/SiteFooter";
import { siteNav, headerCta } from "../lib/navigation";

interface Props {
  title?: string;
  description?: string;
  /** La home preloada la foto profilo: è l'immagine LCP di quella pagina. */
  preloadProfileImage?: boolean;
}

const {
  title = "Fabio Tognarelli — studente di informatica, Pisa",
  description = "Studente di informatica a Pisa. Sviluppo web, progetti e contatto.",
  preloadProfileImage = false,
} = Astro.props;

const origin = Astro.site ?? new URL("https://fabiotognarelli.vercel.app");
const canonical = new URL(Astro.url.pathname, origin).href;
const profileImage = new URL("/images/profile/tognarelli-1200.webp", origin).href;

const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Fabio Tognarelli",
  url: canonical,
  image: profileImage,
  jobTitle: "Studente di informatica",
  address: { "@type": "PostalAddress", addressLocality: "Pisa", addressCountry: "IT" },
  affiliation: { "@type": "CollegeOrUniversity", name: "Università di Pisa" },
  sameAs: [
    "https://www.linkedin.com/in/fabio-tognarelli",
    "https://github.com/FabioTognaa",
  ],
};
---

<!doctype html>
<html lang="it">
  <head>
    <title>{title}</title>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google-site-verification" content="UZ8RtnAPGkwtAu7-2TQDfP4JlbvEJnafWsZxbfAoPF4" />
    {
      preloadProfileImage && (
        <link
          rel="preload"
          as="image"
          href="/images/profile/tognarelli-800.webp"
          type="image/webp"
          fetchpriority="high"
        />
      )
    }

    <meta name="description" content={description} />
    <meta name="author" content="Fabio Tognarelli" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={profileImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="800" />
    <meta property="og:image:alt" content="Ritratto di Fabio Tognarelli" />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:site_name" content="Fabio Tognarelli" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={profileImage} />
    <meta name="theme-color" content="#121f33" />

    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <a href="#main-content" class="skip-link">Vai al contenuto</a>

    <header class="site-header">
      <div class="site-header__bar">
        <nav class="hidden items-center gap-8 md:flex" aria-label="Navigazione principale">
          {siteNav.map((item) => (
            <a href={item.href} class="nav-link">{item.label}</a>
          ))}
        </nav>

        <div class="flex items-center gap-3">
          <a
            href={headerCta.href}
            download={headerCta.download}
            class="btn-primary hidden px-5 py-2.5 text-sm sm:inline-flex"
          >
            {headerCta.label}
          </a>
          <MobileMenu />
        </div>
      </div>
    </header>

    <main id="main-content" class="flex-1" tabindex="-1">
      <div class="page-enter"><slot /></div>
    </main>

    <SiteFooter />

    <script>
      import { observeReveal } from "../lib/revealObserver";

      // reveal on scroll: attributo data-visible, non una classe, così React
      // durante l'idratazione non lo rimuove
      const revealed = document.querySelectorAll<HTMLElement>("[data-reveal]");
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
        revealed.forEach((el) => el.setAttribute("data-visible", ""));
      } else {
        revealed.forEach((el) =>
          observeReveal(el, (visible) => {
            if (visible) el.setAttribute("data-visible", "");
          }),
        );
      }

      // header: stato "scrolled" senza React
      const header = document.querySelector(".site-header");
      if (header) {
        let ticking = false;
        const sync = () => {
          header.toggleAttribute("data-scrolled", window.scrollY > 32);
          ticking = false;
        };
        sync();
        window.addEventListener(
          "scroll",
          () => {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(sync);
          },
          { passive: true },
        );
      }
    </script>
  </body>
</html>
